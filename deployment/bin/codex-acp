#!/usr/bin/env node
import { readFileSync } from "node:fs"
import { homedir } from "node:os"
import path from "node:path"
import { spawn } from "node:child_process"

// Use the maintained host CLI instead of the adapter's bundled Codex 0.147.0.
const env = { ...process.env, NO_BROWSER: "1", CODEX_PATH: "/usr/bin/codex" }
if (!env.CODEX_API_KEY && !env.OPENAI_API_KEY) {
  try {
    const auth = JSON.parse(readFileSync(path.join(env.CODEX_HOME || path.join(homedir(), ".codex"), "auth.json"), "utf8"))
    if (typeof auth.OPENAI_API_KEY === "string" && auth.OPENAI_API_KEY.trim()) {
      env.CODEX_API_KEY = auth.OPENAI_API_KEY
    }
  } catch {
    // Never print credential file contents or parser errors.
  }
}
if (!env.CODEX_API_KEY && !env.OPENAI_API_KEY) {
  process.stderr.write("Harness Remote: no Codex API key in environment or auth.json; browser login is disabled.\n")
  process.exit(1)
}
const child = spawn("/usr/bin/npx", ["--yes", "--package=@agentclientprotocol/codex-acp@1.1.14", "codex-acp", ...process.argv.slice(2)], { env, stdio: "inherit" })
for (const signal of ["SIGTERM", "SIGINT"]) process.on(signal, () => child.kill(signal))
child.on("error", () => { process.stderr.write("Cannot start Codex ACP adapter.\n"); process.exitCode = 1 })
child.on("exit", (code) => { process.exitCode = code ?? 1 })
